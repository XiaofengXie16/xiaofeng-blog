# Repository-only files. The build context is filtered by this file alone, so
# anything not listed here is copied into the image by `COPY --link . .`.
# None of these are needed to build or run `./.output/server/index.mjs`.
.git
.github
.gitignore
.changeset
.claude
.entire
.vite-hooks
AGENTS.md
CLAUDE.md
README.md
bun.lock

node_modules

/.cache
/build
/.output
/public/build
.env
