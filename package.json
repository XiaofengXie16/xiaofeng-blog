    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/ai": "^1.0.1",
    "@tanstack/ai-groq": "^1.0.0",
    "@tanstack/react-hotkeys": "^0.20.2",
    "@tanstack/react-pacer": "^0.24.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.4",
    "@tanstack/redact": "^0.2.3",
    "gray-matter": "^4.0.3",
    "marked": "^18.1.2",
    "nitro": "^3.0.261029-rc",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
