    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxc-transform-react": "^0.156.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=24.0.0"
